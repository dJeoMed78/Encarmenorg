<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="800" viewBox="0 0 1200 800">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#064e3b"/>
      <stop offset="50%" stop-color="#0f766e"/>
      <stop offset="100%" stop-color="#1e293b"/>
    </linearGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#fbbf24"/>
      <stop offset="100%" stop-color="#f59e0b"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="800" fill="url(#bg)"/>
  <circle cx="1050" cy="150" r="300" fill="#fbbf24" opacity="0.08"/>
  <circle cx="150" cy="650" r="250" fill="#10b981" opacity="0.08"/>
  
  <!-- Badge -->
  <rect x="100" y="100" width="360" height="50" rx="25" fill="#fbbf24" fill-opacity="0.2" stroke="#fbbf24" stroke-width="2"/>
  <text x="280" y="132" fill="#fde68a" font-family="system-ui, sans-serif" font-size="20" font-weight="bold" text-anchor="middle">CARTELERA OFICIAL DE CARMEN</text>
  
  <!-- Title -->
  <text x="100" y="240" fill="#ffffff" font-family="system-ui, sans-serif" font-size="58" font-weight="900">9.° CONGRESO</text>
  <text x="100" y="320" fill="url(#accent)" font-family="system-ui, sans-serif" font-size="58" font-weight="900">AGROINDUSTRIAL</text>
  <text x="100" y="390" fill="#a7f3d0" font-family="system-ui, sans-serif" font-size="38" font-weight="600">CIUDAD DEL CARMEN 2026</text>
  
  <!-- Divider -->
  <line x1="100" y1="440" x2="1100" y2="440" stroke="#34d399" stroke-opacity="0.3" stroke-width="2"/>
  
  <!-- Details -->
  <text x="100" y="510" fill="#ffffff" font-family="system-ui, sans-serif" font-size="26" font-weight="bold">📅 Sábado 3 y Domingo 4 de Octubre de 2026</text>
  <text x="100" y="560" fill="#e2e8f0" font-family="system-ui, sans-serif" font-size="24">📍 Centro de Convenciones Carmen XXI • 9:00 AM - 7:00 PM</text>
  <text x="100" y="610" fill="#fbbf24" font-family="system-ui, sans-serif" font-size="24" font-weight="bold">🎟️ Entrada Libre • Evento 100% Familiar y Empresarial</text>
  
  <!-- Footer tag -->
  <rect x="100" y="680" width="460" height="45" rx="10" fill="#047857" opacity="0.6"/>
  <text x="330" y="710" fill="#ecfdf5" font-family="system-ui, sans-serif" font-size="18" font-weight="600" text-anchor="middle">Conferencias • Expo Agrícola • Networking</text>
</svg>