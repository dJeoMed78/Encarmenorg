{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    },
    {
      "source": "/images/(.*)",
      "destination": "/api"
    },
    {
      "source": "/empresa/(.*)",
      "destination": "/api"
    },
    {
      "source": "/negocio/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api|uploads|images|assets|icons).*)",
      "destination": "/index.html"
    }
  ]
}
