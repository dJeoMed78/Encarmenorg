# ==============================================================================
# ENCARMEN — Configuración del Entorno de Staging (staging.encarmen.org)
# Tarea: ENC-STAGING-ENV-READINESS-001
# ==============================================================================
# NOTA DE SEGURIDAD:
# Este archivo contiene la plantilla estándar para aislar el entorno de Staging.
# NUNCA ingresar contraseñas reales ni credenciales de producción en este archivo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IDENTIFICACIÓN DEL ENTORNO
# ------------------------------------------------------------------------------
APP_ENV=staging
NODE_ENV=production
PORT=3000
APP_URL=https://staging.encarmen.org
PUBLIC_URL=https://staging.encarmen.org

# ------------------------------------------------------------------------------
# 2. POLÍTICA DE AISLAMIENTO Y PROTECCIÓN DE DATOS (DEFENSA EN PROFUNDIDAD)
# ------------------------------------------------------------------------------
# STAGING_READ_ONLY:
# 'true' (Recomendado): Rechaza todas las operaciones de escritura (POST, PUT,
# DELETE, PATCH) a nivel de middleware HTTP y repositorios de base de datos.
# Ideal para demostraciones seguras y pruebas de interfaz de usuario.
STAGING_READ_ONLY=true

# STAGING_SAFE_MODE:
# 'true': Activa automáticamente las barreras de protección de Staging.
STAGING_SAFE_MODE=true

# STAGING_STRICT_BOOT:
# 'true': Detiene el proceso (exit 1) durante el arranque si se detecta cualquier
# intento de conexión a la base de datos de producción (u293982346_encarmenapp)
# o si faltan las variables explícitas requeridas para Staging.
STAGING_STRICT_BOOT=true

# STAGING_DB_CONFIRMED:
# 'false' por defecto. Solo si se requiere probar escrituras sobre una base de datos
# de pruebas dedicada y verificada (ej. u293982346_encarmentest), debe establecerse
# en 'true' junto con STAGING_READ_ONLY=false.
# Si apunta a la base de datos de producción, el arranque será rechazado aunque esté en 'true'.
STAGING_DB_CONFIRMED=false

# STAGING_ALLOW_SCHEMA_INIT:
# 'false' por defecto. Impide que Staging ejecute sentencias DDL (CREATE TABLE)
# destructivas o automáticas sobre la base de datos conectada.
STAGING_ALLOW_SCHEMA_INIT=false

# ------------------------------------------------------------------------------
# 3. BASE DE DATOS MARIADB HOSTINGER (AISLADA DE PRODUCCIÓN)
# ------------------------------------------------------------------------------
# PROHIBIDO usar la base de datos de producción: u293982346_encarmenapp
# PROHIBIDO usar el usuario de escritura de producción: u293982346_appuser
#
# Para Staging, utilice la base de datos de pruebas creada en Hostinger:
DB_HOST=srv1356.hstgr.io
DB_PORT=3306
DB_NAME=u293982346_encarmentest
DB_USER=u293982346_staginguser
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_DE_STAGING

# ------------------------------------------------------------------------------
# 4. AISLAMIENTO DE SERVICIOS EXTERNOS Y DOMINIOS DE PRODUCCIÓN
# ------------------------------------------------------------------------------
# Deshabilita la sincronización con WordPress/WooCommerce de producción
ENABLE_WP_SYNC=false

# Deshabilita la purga automática de caché de Cloudflare y LiteSpeed sobre:
# https://encarmen.org y https://empresasencarmen.com
ENABLE_CACHE_PURGE=false

# Deshabilita la aprobación de schema de ratings sin revisión previa
RATINGS_SCHEMA_APPROVED=false
