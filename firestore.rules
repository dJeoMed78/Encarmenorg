rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /businesses/{businessId} {
      allow read: if true;
      allow write: if true;
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if true;
    }
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }
    match /system/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /uploaded_images/{imageId} {
      allow read: if true;
      allow write: if true;
    }
    match /analytics/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
